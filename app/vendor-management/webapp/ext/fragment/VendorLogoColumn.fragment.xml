<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Avatar
        id="vendorLogo"
        src="{logoUrl}"
        initials="{name}"
        fallbackIcon="sap-icon://building"
        displayShape="Square"
        displaySize="Custom"
        customDisplaySize="36px"
        customFontSize="12px"
        showBorder="true"
        tooltip="{name}"
    />
</core:FragmentDefinition>
